# Port for the server to listen on
PORT=5000

# Local PostgreSQL database connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:password@localhost:5432/authfortress"

# Session secret for signing the session ID cookie.
# Replace with a long, random string.
SESSION_SECRET="a-very-secret-and-long-string-for-session-management"

# Gemini API key (optional, if using AI features)
GEMINI_APUI_KEY=""
